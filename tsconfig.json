{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ESNext"
		],
		"types": [
			"node",
			"@cloudflare/workers-types/experimental"
		],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src",
		"db",
		"scripts",
		"alchemy.run.ts",
		"drizzle.config.ts",
		"drizzle-do.config.ts"
	]
}
