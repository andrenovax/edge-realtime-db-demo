{
  "name": "flue-alchemy-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd infra && nub run dev",
    "deploy": "cd infra && nub run deploy",
    "check:types": "tsc --noEmit && tsc -p src/web/user --noEmit",
    "lint": "oxlint",
    "lint:boundaries": "nub scripts/check-boundaries.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "smoke": "nub scripts/realtime-smoke.ts",
    "demo:setup": "nub scripts/setup-demo.ts",
    "smoke:all": "nub scripts/rpc-smoke.ts && nub scripts/realtime-smoke.ts && nub scripts/livestore-smoke.ts && nub scripts/notes-bridge-smoke.ts && nub scripts/projection-smoke.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0-rc.5",
    "@flue/runtime": "^2.0.3",
    "@heroui/react": "^3.2.4",
    "@livestore/adapter-cloudflare": "^0.4.0",
    "@livestore/adapter-web": "^0.4.0",
    "@livestore/livestore": "^0.4.0",
    "@livestore/react": "^0.4.0",
    "@livestore/sync-cf": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "better-auth": "1.7.0-rc.5",
    "capnweb": "^0.10.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "^3.21.2",
    "hono": "4.13.1",
    "jose": "^6.2.8",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@flue/cli": "^2.0.3",
    "@flue/vite": "^2.0.3",
    "@livestore/adapter-node": "^0.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "allowBuilds": {
    "@google/genai": false,
    "@parcel/watcher": true,
    "core-js-pure": false,
    "esbuild": true,
    "msgpackr-extract": false,
    "protobufjs": false,
    "workerd": true
  }
}
