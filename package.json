{
  "name": "flue-alchemy-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock run -- nub --cwd infra run dev",
    "build": "vite build src/web/user",
    "deploy": "varlock run -- nub --cwd infra run deploy",
    "env:check": "varlock load --agent",
    "env:audit": "varlock audit src scripts infra db --ignore infra/.alchemy",
    "env:scan": "varlock scan",
    "css:types": "tcm --pattern '**/*.module.css' src/web/user",
    "check:css-types": "tcm --listDifferent --pattern '**/*.module.css' src/web/user",
    "check:types": "tcm --listDifferent --pattern '**/*.module.css' src/web/user && tsc --noEmit && tsc -p src/web/user --noEmit",
    "lint": "oxlint",
    "lint:boundaries": "nub scripts/check-boundaries.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate --config db/auth/drizzle.config.ts && drizzle-kit generate --config db/admin/drizzle.config.ts",
    "smoke": "nub scripts/smoke/all.ts",
    "smoke:auth": "nub scripts/smoke/auth-smoke.ts",
    "smoke:rpc": "nub scripts/smoke/rpc-smoke.ts",
    "smoke:realtime": "nub scripts/smoke/realtime-smoke.ts",
    "smoke:livestore": "nub scripts/smoke/livestore-smoke.ts",
    "smoke:projection": "nub scripts/smoke/projection-smoke.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.14",
    "@assistant-ui/react-markdown": "^0.14.10",
    "@better-auth/drizzle-adapter": "1.7.0-rc.5",
    "@blocknote/ariakit": "^0.54.0",
    "@blocknote/core": "^0.54.0",
    "@blocknote/react": "^0.54.0",
    "@flue/react": "^2.0.3",
    "@flue/runtime": "^2.0.3",
    "@flue/sdk": "^2.0.3",
    "@heroui/react": "^3.2.4",
    "@livestore/adapter-cloudflare": "^0.4.0",
    "@livestore/adapter-web": "^0.4.0",
    "@livestore/livestore": "^0.4.0",
    "@livestore/react": "^0.4.0",
    "@livestore/sync-cf": "^0.4.0",
    "@livestore/wa-sqlite": "^0.4.0",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-store": "^0.11.1",
    "better-auth": "1.7.0-rc.5",
    "capnweb": "^0.10.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "^3.21.2",
    "hono": "4.13.1",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@flue/cli": "^2.0.3",
    "@flue/vite": "^2.0.3",
    "@livestore/adapter-node": "^0.4.0",
    "@livestore/devtools-vite": "0.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.30",
    "@types/node": "^22.10.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@varlock/1password-plugin": "^2.0.3",
    "@vitejs/devtools": "0.4.10",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typed-css-modules": "^0.9.1",
    "typescript": "^7.0.2",
    "varlock": "^1.16.1",
    "vite": "^8.0.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "allowBuilds": {
    "@google/genai": false,
    "@parcel/watcher": true,
    "core-js-pure": false,
    "esbuild": true,
    "msgpackr-extract": false,
    "protobufjs": false,
    "workerd": true
  }
}
