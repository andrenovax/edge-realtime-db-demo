# This file uses @env-spec. It is safe to commit and safe for AI tools to read.
# Keep secret values in gitignored .env.local / .env.<environment>.local files,
# preferably as 1Password op(...) references or device-local varlock(...) values.
#
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(development))
# @currentEnv=$APP_ENV
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ---

# Selects .env.<environment> files. Override this in CI and deploy commands.
# @required @type=enum(development, test, preview, staging, production)
# @docs(https://varlock.dev/guides/environments/)
APP_ENV=development

# Base name of the public Cloudflare gateway Worker. Deployment stages derive
# their physical names from this value (for example, do-staging and do-pr-42).
# @required
CLOUDFLARE_WORKER_NAME=do

# Optional 1Password service-account credential for CI and production.
# It is consumed by Varlock only and is never injected into the application.
# Local development may instead use 1Password desktop-app authentication.
# @optional @internal @sensitive @type=opServiceAccountToken
# @docs(https://varlock.dev/plugins/1password/)
OP_SERVICE_ACCOUNT_TOKEN=

# Better Auth signing secret installed only on the auth Worker.
# In a gitignored env file, prefer:
# BETTER_AUTH_SECRET=op("op://your-vault/better-auth/credential")
# @required @sensitive @auditIgnore @type=string(minLength=32)
# @docs(https://www.better-auth.com/docs/reference/options#secret)
BETTER_AUTH_SECRET=

# Cloudflare account containing the deployed Workers and related resources.
# @required=forEnv(preview, staging, production) @auditIgnore
# @docs(https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token used only by Alchemy during deployment and cleanup.
# @required=forEnv(preview, staging, production) @sensitive @auditIgnore
# @docs(https://developers.cloudflare.com/fundamentals/api/get-started/create-token/)
CLOUDFLARE_API_TOKEN=
